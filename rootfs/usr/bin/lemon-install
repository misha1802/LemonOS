#!/bin/sh
set -e

DISK="/dev/sda"
TARGET="/mnt/target"

echo "=== LemonOS Installer ==="
echo "WARNING: This will erase all data on $DISK!"
echo "Press ENTER to continue..."
read tmp

echo "Formatting disk..."
echo "label: dos" | sfdisk $DISK
echo ",,L,*" | sfdisk $DISK

MNT_DEV="${DISK}1"
mkfs.ext4 -O "^metadata_csum,^64bit" -F $MNT_DEV

echo "Copying system files to HDD..."
mkdir -p $TARGET
mount $MNT_DEV $TARGET

cp -a /bin /sbin /etc /lib /usr /var /home $TARGET/
mkdir -p $TARGET/proc $TARGET/sys $TARGET/dev $TARGET/mnt $TARGET/boot /run

cat << 'EOF' > $TARGET/init
#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

mkdir -p /dev/pts /tmp /var/cache/apk /run
mount -t devpts none /dev/pts
mount -t tmpfs -o size=128M tmpfs /var/cache/apk
mount -t tmpfs -o size=16M tmpfs /run

chmod 1777 /tmp

ln -sf /bin/busybox /sbin/poweroff
ln -sf /bin/busybox /sbin/reboot

echo "LemonOS" > /etc/hostname
hostname LemonOS

export USER=lemon
export HOME=/home/lemon
export LOGNAME=lemon
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

udevd --daemon
udevadm trigger

for i in 1 2 3 4 5; do
    if [ -d /sys/class/net/eth0 ] || [ -d /sys/class/net/wlan0 ]; then
        break
    fi
    sleep 1
done

ifconfig eth0 up 2>/dev/null
udhcpc -i eth0 -b -q 2>/dev/null

if [ -d /sys/class/net/wlan0 ]; then
    ifconfig wlan0 up 2>/dev/null
fi

echo "nameserver 8.8.8.8" > /etc/resolv.conf

cat << 'EOF2' > /home/lemon/.bashrc
alias fastfetch="fastfetch --logo linux"
clear
export FASTFETCH_OS_RELEASE="0.5"
fastfetch
PS1='\[\033[01;33m\]\u\[\033[00m\]@\[\033[01;32m\]\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
EOF2

echo "source /usr/share/bash-completion/bash_completion" >> /home/lemon/.bashrc

startx

echo "Xorg crashed or exited. Dropping to rescue shell..."
exec /bin/bash --login
EOF
chmod +x $TARGET/init

cp /boot/vmlinuz $TARGET/boot/vmlinuz

echo "Installing Syslinux bootloader..."
extlinux --install $TARGET/boot

cat << EOF > $TARGET/boot/extlinux.conf
DEFAULT lemonos
LABEL lemonos
  LINUX /boot/vmlinuz
  APPEND root=$MNT_DEV rw quiet
EOF

cat << EOF > $TARGET/extlinux.conf
DEFAULT lemonos
LABEL lemonos
  LINUX /boot/vmlinuz
  APPEND root=$MNT_DEV rw quiet
EOF

dd bs=440 count=1 conv=notrunc if=/usr/share/syslinux/mbr.bin of=$DISK

umount $TARGET
echo ""
echo "Installation complete! You can now reboot and remove your USB drive."
